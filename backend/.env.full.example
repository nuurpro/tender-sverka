# Full application settings. This file does not switch the legacy MVP server.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tender_app:REPLACE_APPLICATION_PASSWORD@127.0.0.1:55432/tender_sverka
# A generated 32+ character secret; never commit real values.
APP_SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
APP_PUBLIC_ORIGIN=http://localhost:3000
CELERY_BROKER_URL=amqp://tender:REPLACE_BROKER_PASSWORD@127.0.0.1:5673/tender
REDIS_URL=redis://127.0.0.1:56379/0
APP_GATEWAY_API_BASE=https://agentrouter.org/v1
APP_GATEWAY_API_STYLE=chat
APP_GATEWAY_MODEL=deepseek-v4-flash
CODEX_GATEWAY_API_KEY=
# Permission to send documents is granted per organization, never globally.
APP_MAX_PACKAGE_FILES=20
APP_MAX_PACKAGE_BYTES=50000000
APP_MAX_PACKAGE_PAGES=1000
APP_MAX_PACKAGE_TOKENS=250000
APP_RETENTION_MONTHS=12
