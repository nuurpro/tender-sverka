# Full application settings. This file does not switch the legacy MVP server.
APP_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tender_app:REPLACE_APPLICATION_PASSWORD@127.0.0.1:55432/tender_sverka
# A generated 32+ character secret; never commit real values.
APP_SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET
# Separate 32+ character secret for the signed worker envelope; init generates it.
APP_JOB_SIGNING_SECRET=REPLACE_WITH_GENERATED_SECRET
APP_PUBLIC_ORIGIN=http://127.0.0.1:3001
# Development only: fixed code 123456, no SMS is sent. Production rejects mock.
APP_SMS_PROVIDER=mock
# Only used by APP_SMS_PROVIDER=http: a relay accepting {phone,message} JSON and
# returning 2xx only when accepted. Missing settings refuse real SMS login.
APP_SMS_ENDPOINT=
APP_SMS_TOKEN=
CELERY_BROKER_URL=amqp://tender:REPLACE_BROKER_PASSWORD@127.0.0.1:5673/tender
REDIS_URL=redis://127.0.0.1:56379/0
APP_GATEWAY_API_BASE=https://agentrouter.org/v1
APP_GATEWAY_API_STYLE=chat
APP_GATEWAY_MODEL=deepseek-v4-flash
CODEX_GATEWAY_API_KEY=
# Permission to send documents is granted per organization, never globally.
APP_MAX_PACKAGE_FILES=20
APP_MAX_PACKAGE_BYTES=50000000
APP_MAX_PACKAGE_PAGES=1000
APP_MAX_PACKAGE_TOKENS=250000
# Encrypted originals: init generates local values in ignored infrastructure/.env.
# These variables are required together for upload/download and orphan cleanup.
# Production requires an HTTPS S3 endpoint and a private bucket.
S3_ENDPOINT_URL=http://127.0.0.1:53900
S3_REGION=garage
S3_BUCKET=tender-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Generated 64-character hex value (256 bits); never commit an actual key.
DOCUMENT_ENCRYPTION_KEY=
APP_DOCUMENT_MASTER_KEY_VERSION=v1
# Immediate admission limit for bounded document receiving/decryption in RAM.
APP_MAX_ACTIVE_UPLOADS=2
# Native parsing requires a qualified isolated runtime; use the staging helper
# and paths it returns before selecting wsl-bubblewrap (development) or
# bubblewrap (Linux). Missing isolation blocks normalization.
DOCUMENT_RUNNER_MODE=disabled
DOCUMENT_RUNTIME_PYTHON=/home/acer/.local/share/tender-sverka/document-runtime/bin/python
# Required before enabling the runner: SHA-256 of the qualified system Python.
# Obtain with the OS sha256sum tool; re-qualify after interpreter updates.
DOCUMENT_RUNTIME_PYTHON_SHA256=
DOCUMENT_PARSER_CODE_PATH=/home/acer/.local/share/tender-sverka/document-parser/app/documents
DOCUMENT_WSL_DISTRIBUTION=Ubuntu
# Explicit OCR opt-in, independent of installation or model names. A requested
# but unqualified/missing toolchain refuses processing; native-v1 stays readable.
# Stage the exact parser code and verify actual binaries/assets before enabling.
APP_DOCUMENT_OCR_MODE=disabled
APP_DOCUMENT_OCR_MAX_FRAME_PIXELS=12000000
APP_DOCUMENT_OCR_MAX_TOTAL_PIXELS=2000000000
APP_DOCUMENT_OCR_MAX_RASTER_PIXELS=8000000
APP_DOCUMENT_OCR_RASTER_DPI=200
APP_DOCUMENT_OCR_PAGE_SEGMENTATION=3
APP_DOCUMENT_OCR_LOW_CONFIDENCE_REVIEW=85
# Whole-document bound across sequential chunks; runner wall/CPU/RAM bounds
# still apply separately to each child. This is not a throughput guarantee.
APP_DOCUMENT_OCR_DOCUMENT_SECONDS=3600
APP_RETENTION_MONTHS=12
