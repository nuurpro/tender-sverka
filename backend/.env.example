OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol
# openai = real OpenAI-compatible API, demo = supplied educational documents only
AI_MODE=openai
# Empty = automatic: Chat Completions JSON mode for AgentRouter, Responses for other URLs.
OPENAI_API_STYLE=
# AgentRouter alternative (uncomment URL/model and supply the gateway key):
# OPENAI_API_BASE=https://agentrouter.org/v1
# OPENAI_API_STYLE=chat
# OPENAI_MODEL=deepseek-v4-flash
CODEX_GATEWAY_API_KEY=
# For AgentRouter, CODEX_GATEWAY_API_KEY takes priority over OPENAI_API_KEY.
# Alternatively put the gateway key in OPENAI_API_KEY.
# DATA_DIR=./data
